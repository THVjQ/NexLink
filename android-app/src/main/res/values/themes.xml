<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexLink" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent2</item>
        <item name="colorOnPrimary">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="bottomNavigationStyle">@style/NexLinkBottomNav</item>
    </style>

    <style name="NexLinkBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bg</item>
        <item name="itemIconTint">@color/nav_icon_tint</item>
        <item name="itemTextColor">@color/nav_icon_tint</item>
    </style>

    <style name="DialerSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/DialerBottomSheet</item>
    </style>

    <style name="DialerBottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@color/surface</item>
    </style>

    <style name="DialKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="backgroundTint">@color/surface2</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
