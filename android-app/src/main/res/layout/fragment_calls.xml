<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:text="Calls" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Phone &amp; VoIP" android:textSize="12sp" android:textColor="@color/muted"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialpad"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Dialpad" android:backgroundTint="@color/accent"/>
    </LinearLayout>

    <TextView android:text="RECENT CALLS" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted" android:letterSpacing="0.09"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="4dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCalls"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="8dp" android:clipToPadding="false"/>

</LinearLayout>
