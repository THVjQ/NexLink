<?xml version="1.0" encoding="utf-8"?>
<!--
  LIGHT THEME.

  **Recoloured 2026-09-16.** The palette was a neutral iOS grey system — pure
  #F2F2F7 ground, pure white cards, pure black text — and on a phone it read as
  an unfinished wireframe rather than a product. Grey is not a neutral choice;
  it is the absence of one.

  Every neutral here is now biased a few degrees toward the accent's hue, which
  is what makes a surface read as *chosen* rather than *defaulted*. The ground
  is a cool off-white, the cards are white so they lift off it, and the text is
  a very dark blue-black rather than #000000 — pure black on white is harsher
  than any printed page and is the single loudest tell of an unstyled Android
  app.

  The accent is unchanged in role and slightly deepened: it has to carry white
  text as a fill (see social_accent_fill) and still read as a link on the
  ground.

  EVERY pair below is checked by tools/check-contrast.py in BOTH themes and
  passes WCAG AA (§14.10). The previous palette's five AA failures were found by
  that script and not by eye; do not add a colour here without adding its pair.
-->
<resources>
    <!-- the screen behind everything -->
    <color name="social_bg">#F4F6FB</color>
    <!-- cards, rows, bars -->
    <color name="social_surface">#FFFFFF</color>
    <!-- inputs, the composer field, a recessed row -->
    <color name="social_surface2">#EDF1F8</color>
    <!-- chips, day markers, the quietest fill -->
    <color name="social_surface3">#DFE6F2</color>
    <!-- links, selected state, text on a ground -->
    <color name="social_accent">#1257D6</color>
    <!-- the lighter end of the accent gradient -->
    <color name="social_accent2">#3B82F6</color>
    <!-- a FILLED control: send, unread badge, your own bubble -->
    <color name="social_accent_fill">#1257D6</color>
    <!-- text on any filled control -->
    <color name="social_on_accent_fill">#FFFFFF</color>
    <!-- the timestamp inside your own bubble -->
    <color name="social_on_accent_fill_meta">#E4EEFE</color>
    <!-- primary text -->
    <color name="social_text">#0C1420</color>
    <!-- secondary text — previews, body copy -->
    <color name="social_text2">#2E3A4D</color>
    <!-- captions, timestamps, explanatory lines -->
    <color name="social_muted">#59657A</color>
    <!-- hairlines. Decorative: see DECORATIVE in check-contrast.py -->
    <color name="social_divider">#D5DDEB</color>
    <!-- destructive and failed states -->
    <color name="social_danger">#C2273D</color>
    <!-- §9.6.1 'we cannot see' column -->
    <color name="social_cannot_see">#12694A</color>
    <!-- §9.6.1 'we can see' column — same weight, deliberately -->
    <color name="social_can_see">#8A4B00</color>
    <!-- the standing-warning card -->
    <color name="social_banner_bg">#FFF3E0</color>
    <!-- an incoming message -->
    <color name="social_bubble_theirs">#FFFFFF</color>
    <!-- the time under an incoming message -->
    <color name="social_bubble_meta">#59657A</color>
    <!-- the initial in an avatar -->
    <color name="social_on_avatar">#FFFFFF</color>
    <!-- avatar tints, hashed from the name -->
    <color name="social_avatar1">#2C6BB0</color>
    <color name="social_avatar2">#7A4FA3</color>
    <color name="social_avatar3">#1F7A5C</color>
    <color name="social_avatar4">#A8452F</color>
    <color name="social_avatar5">#5C6B8A</color>
</resources>
