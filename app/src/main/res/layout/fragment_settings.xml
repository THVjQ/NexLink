<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:text="Settings" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- Permissions status -->
        <TextView android:text="PERMISSIONS" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <TextView android:text="SMS Access" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/statusSms" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <TextView android:text="Contacts" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/statusContacts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <TextView android:text="Call Log" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/statusCalls" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <TextView android:text="Make Calls" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/statusPhone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <TextView android:text="Notification Access" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp"/>
                <TextView android:id="@+id/statusNotif" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/muted"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Grant Notification Access" android:backgroundTint="@color/accent"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="App Permissions &amp; Settings"
            android:layout_marginBottom="20dp"/>

        <!-- Messaging features -->
        <TextView android:text="MESSAGING" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="16dp">

            <!-- RCS Chats -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="RCS Chats"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:text="Enable rich messaging (read receipts, typing indicators) when carrier supports it"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchRcs"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="4dp"/>

            <!-- End-to-End Encryption toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="End-to-End Encryption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:text="Automatically encrypt messages with NexLink contacts (EC P-256 + AES-256-GCM)"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEncryption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Appearance section -->
        <TextView android:text="APPEARANCE" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="16dp">

            <!-- Dark mode -->
            <LinearLayout android:id="@+id/rowDarkMode"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Dark Mode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvDarkModeValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp" android:text="System default"/>
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="4dp"/>

            <!-- App icon -->
            <LinearLayout android:id="@+id/rowAppIcon"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="App Icon"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvAppIconValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp" android:text="Default"/>
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="4dp"/>

            <!-- Notification icon -->
            <LinearLayout android:id="@+id/rowNotifIcon"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Notification Icon"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvNotifIconValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp" android:text="Default"/>
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Notification behaviour -->
        <TextView android:text="NOTIFICATIONS" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="8dp">

            <!-- Suppress source notifications -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Only notify via NexLink"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:text="Suppress notifications from Signal, Telegram, WhatsApp, Messenger — show only NexLink's"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSuppressSource"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Suppress call notifications from social apps -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Suppress social missed calls"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:text="Don't show missed/declined call alerts from Signal, Telegram etc."
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSuppressCallNotifs"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Voice message pass-through -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Pass through voice messages"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:text="Always allow voice message notifications from social apps (so they can be played)"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPassThroughMedia"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Social Platforms (collapsible) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp" android:layout_marginTop="12dp">
            <TextView android:text="SOCIAL PLATFORMS" android:textSize="11sp" android:textStyle="bold"
                android:textColor="@color/muted" android:letterSpacing="0.09"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <ImageButton android:id="@+id/btnToggleSocials"
                android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/muted"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Toggle social platforms"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardSocialPlatforms"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <!-- Signal -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Signal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformSignal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Telegram -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Telegram"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformTelegram"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- WhatsApp -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="WhatsApp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformWhatsapp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Messenger -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Messenger"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformMessenger"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Discord -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Discord"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformDiscord"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Instagram -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Instagram"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformInstagram"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Steam -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Steam"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlatformSteam"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Privacy Section -->
        <TextView android:text="PRIVACY" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="16dp">

            <!-- Blocked Numbers row -->
            <LinearLayout android:id="@+id/rowBlockedNumbers"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Blocked Numbers"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvBlockedCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp" android:text="No blocked numbers"/>
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="4dp"/>

            <!-- Recycle Bin row -->
            <LinearLayout android:id="@+id/rowRecycleBin"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Recycle Bin"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRecycleBinCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp"
                        android:layout_marginTop="2dp" android:text="Empty"/>
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Bug Report / Support -->
        <TextView android:text="SUPPORT" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

        <!-- Share Contact (QR) row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="16dp">
            <LinearLayout android:id="@+id/rowShareContact"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Share My Contact (QR)"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="14sp"/>
                    <TextView android:text="Generate a QR code with your contact details"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp"
            android:layout_marginBottom="16dp">
            <TextView android:text="Found a bug? Tap below to open a GitHub issue."
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textSize="13sp"
                android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/btnReportBug"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Report a Bug"
                android:backgroundTint="@color/accent"
