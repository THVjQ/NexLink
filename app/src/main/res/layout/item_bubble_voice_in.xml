<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="start"
    android:paddingHorizontal="12dp" android:paddingVertical="3dp">
    <TextView android:id="@+id/tvSenderName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold"
        android:layout_marginStart="4dp" android:layout_marginBottom="2dp"
        android:visibility="gone"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_bubble_in"
        android:paddingHorizontal="14dp" android:paddingVertical="10dp">
        <ImageButton android:id="@+id/btnPlay"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_action_btn"
            android:src="@drawable/ic_play"
            android:padding="8dp"/>
        <TextView android:id="@+id/tvBubble"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎤 Voice message"
            android:textColor="@color/text" android:textSize="14sp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvTime"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="11sp"
        android:layout_marginTop="3dp" android:layout_marginStart="4dp"/>
</LinearLayout>
