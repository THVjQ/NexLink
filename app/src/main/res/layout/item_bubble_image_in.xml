<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="start"
    android:paddingHorizontal="12dp" android:paddingVertical="3dp">
    <TextView android:id="@+id/tvSenderName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold"
        android:layout_marginStart="4dp" android:layout_marginBottom="2dp"
        android:visibility="gone"/>
    <FrameLayout
        android:layout_width="220dp" android:layout_height="180dp">
        <ImageView android:id="@+id/ivBubble"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_bubble_in"
            android:clipToOutline="true"/>
        <ProgressBar
            android:id="@+id/pbSending"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/text"
            android:visibility="gone"/>
    </FrameLayout>
    <TextView android:id="@+id/tvTime"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="11sp"
        android:layout_marginTop="3dp" android:layout_marginStart="4dp"/>
</LinearLayout>
