<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="Calls" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Phone &amp; VoIP" android:textSize="12sp" android:textColor="@color/muted"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:text="RECENT CALLS" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/muted" android:letterSpacing="0.09"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="4dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCalls"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:padding="8dp" android:paddingBottom="80dp" android:clipToPadding="false"/>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnDialpad"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="20dp"
        android:contentDescription="Dialpad"
        app:srcCompat="@drawable/ic_call"
        app:backgroundTint="@color/accent"/>

</FrameLayout>
