<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp"
        android:paddingTop="16dp" android:paddingBottom="10dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:text="Inbox" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvSub" android:textSize="12sp" android:textColor="@color/muted"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="All platforms"/>
        </LinearLayout>
    </LinearLayout>

    <!-- App cards — tap once to filter (highlighted), tap again to deselect.
         Multiple cards can be active at once. No chips bar. -->
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="2" android:padding="10dp" android:useDefaultMargins="true">

        <LinearLayout android:id="@+id/cardSignal" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_columnWeight="1"
            android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/bg_card_unselected" android:layout_margin="5dp"
            android:clickable="true" android:focusable="true">
            <TextView android:text="Signal" android:textColor="#3a9bd5"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="E2E encrypted" android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/badgeSignal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#fff" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/bg_badge" android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" android:layout_marginTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardTelegram" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_columnWeight="1"
            android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/bg_card_unselected" android:layout_margin="5dp"
            android:clickable="true" android:focusable="true">
            <TextView android:text="Telegram" android:textColor="#229ed9"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Cloud messaging" android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/badgeTelegram"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#fff" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/bg_badge" android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" android:layout_marginTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardWhatsapp" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_columnWeight="1"
            android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/bg_card_unselected" android:layout_margin="5dp"
            android:clickable="true" android:focusable="true">
            <TextView android:text="WhatsApp" android:textColor="#25d366"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="8 chats · 3 groups" android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/badgeWhatsapp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#fff" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/bg_badge" android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" android:layout_marginTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardMessenger" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_columnWeight="1"
            android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/bg_card_unselected" android:layout_margin="5dp"
            android:clickable="true" android:focusable="true">
            <TextView android:text="Messenger" android:textColor="#0099ff"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="5 chats" android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/badgeMessenger"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#fff" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/bg_badge" android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" android:layout_marginTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

    </GridLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- Notification list -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="4dp" android:clipToPadding="false"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
