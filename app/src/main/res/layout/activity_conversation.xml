<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"/>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"/>

    <TextView android:id="@+id/tvSimIndicator"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingHorizontal="10dp" android:paddingVertical="4dp"
        android:layout_marginEnd="14dp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp"
        android:textSize="11sp" android:textColor="@color/accent"
        android:background="@drawable/bg_card_selected"
        android:clickable="true" android:focusable="true"
        android:visibility="gone"/>

    <!-- Shown when there are more messages above the loaded window -->
    <TextView android:id="@+id/btnLoadEarlier"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⬆  Load all earlier messages"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"/>

    <View android:id="@+id/dividerLoadEarlier"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:clipToPadding="false"/>

    <!-- Compose bar — Samsung Messages style -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp" android:paddingVertical="10dp"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <EditText android:id="@+id/etInput"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="Message" android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp" android:paddingVertical="10dp"
            android:textSize="15sp" android:maxLines="5"
            android:inputType="textMultiLine|textCapSentences"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:backgroundTint="@color/accent"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_send"
            app:iconTint="#ffffff"
            app:iconGravity="textStart"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

    </LinearLayout>
</LinearLayout>
