<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground">

    <!-- Coloured initial avatar -->
    <TextView android:id="@+id/tvPickAvatar"
        android:layout_width="44dp" android:layout_height="44dp"
        android:gravity="center"
        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text"
        android:background="@drawable/bg_avatar"/>

    <!-- Name + number -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
        <TextView android:id="@+id/tvPickName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/text"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tvPickNumber"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/muted"
            android:layout_marginTop="1dp"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <!-- Selection indicator (multi-select only) -->
    <ImageView android:id="@+id/ivPickCheck"
        android:layout_width="24dp" android:layout_height="24dp"
        android:visibility="gone"/>

</LinearLayout>
