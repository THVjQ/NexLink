<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="8dp">
        <TextView android:text="Keypad" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <ImageButton android:id="@+id/btnClose"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_action_btn"
            android:src="@drawable/ic_clear" android:tint="@color/text" android:padding="8dp"/>
    </LinearLayout>

    <!-- Contact name — shown when dialer is pre-filled from a saved contact -->
    <TextView android:id="@+id/tvContactName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/text2"
        android:gravity="center" android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:visibility="gone"/>

    <!-- Number display -->
    <TextView android:id="@+id/tvNumber"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="36sp" android:textStyle="bold" android:textColor="@color/text"
        android:gravity="center" android:letterSpacing="0.05"
        android:minHeight="56dp" android:paddingHorizontal="8dp"/>

    <!-- SIM indicator — shown only when multiple SIMs are active -->
    <TextView android:id="@+id/tvSimChip"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
        android:layout_marginStart="16dp"
        android:paddingHorizontal="12dp" android:paddingVertical="4dp"
        android:textSize="11sp" android:textColor="@color/accent"
        android:background="@drawable/bg_card_selected"
        android:clickable="true" android:focusable="true"
        android:text="SIM 1"
        android:visibility="gone"/>

    <!-- Contact suggestions (up to 3, hidden when empty) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestions"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"/>

    <!-- Spacer to push pad down -->
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- Keypad -->
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="3" android:paddingHorizontal="16dp" android:paddingTop="4dp">

        <Button android:id="@+id/k1" style="@style/DialKey" android:text="1"/>
        <Button android:id="@+id/k2" style="@style/DialKey" android:text="2"/>
        <Button android:id="@+id/k3" style="@style/DialKey" android:text="3"/>
        <Button android:id="@+id/k4" style="@style/DialKey" android:text="4"/>
        <Button android:id="@+id/k5" style="@style/DialKey" android:text="5"/>
        <Button android:id="@+id/k6" style="@style/DialKey" android:text="6"/>
        <Button android:id="@+id/k7" style="@style/DialKey" android:text="7"/>
        <Button android:id="@+id/k8" style="@style/DialKey" android:text="8"/>
        <Button android:id="@+id/k9" style="@style/DialKey" android:text="9"/>
        <Button android:id="@+id/kStar" style="@style/DialKey" android:text="*"/>
        <Button android:id="@+id/k0" style="@style/DialKey" android:text="0"/>
        <Button android:id="@+id/kHash" style="@style/DialKey" android:text="#"/>
    </GridLayout>

    <!-- Call + delete -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center"
        android:paddingTop="12dp" android:paddingBottom="40dp" android:paddingHorizontal="32dp">

        <View android:layout_width="64dp" android:layout_height="64dp"/>

        <ImageButton android:id="@+id/btnCall"
            android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/bg_call_green"
            android:src="@drawable/ic_call" android:tint="#fff"
            android:padding="18dp"
            android:layout_marginHorizontal="24dp"/>

        <ImageButton android:id="@+id/btnDel"
            android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/bg_action_btn"
            android:src="@drawable/ic_backspace" android:tint="@color/text"
            android:padding="14dp"/>
    </LinearLayout>
</LinearLayout>
