<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="start" android:padding="4dp">
    <TextView android:id="@+id/tvBubble"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_in" android:padding="12dp"
        android:textColor="@color/text" android:textSize="15sp"
        android:maxWidth="260dp"/>
    <TextView android:id="@+id/tvTime"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="10sp"
        android:layout_marginTop="2dp" android:layout_marginStart="4dp"/>
</LinearLayout>
