<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS / MMS -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.WRITE_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_MMS"/>
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.SEND_RESPOND_VIA_MESSAGE"/>

    <!-- Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>

    <!-- Phone / calls -->
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>

    <!-- Camera & media -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Needed for MediaStore writes on Android 8/9 (API 26–28) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <!-- System -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- DND bypass for priority contacts -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>

    <!-- ── Optional Computer Bridge addon (dormant until enabled in Settings) ── -->
    <!-- connectedDevice FGS type is not the ~6h/day-capped dataSync type (§7b) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- Ask to be exempted from OEM battery sleeping so background delivery is reliable (§7a) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NexLink">

        <!-- ── Main entry (no launcher filter — handled by activity-aliases below) ── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Default launcher alias (enabled by default) -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Custom icon aliases (disabled by default; enabled one at a time via PackageManager) -->
        <activity-alias android:name=".MainActivityIcon1"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_1"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon2"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_2"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon3"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_3"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon4"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_4"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon5"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_5"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon6"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_6"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon7"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_7"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon8"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_8"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon9"  android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_9"  android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityIcon10" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_10" android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>

        <!-- ── SMS conversation ── -->
        <activity
            android:name=".ui.sms.ConversationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- ── Debug console (Settings ▸ Debug) ── -->
        <activity
            android:name=".ui.settings.DebugActivity"
            android:label="Debug"
            android:exported="false"/>

        <!-- ── Optional Computer Bridge (dormant until enabled) ── -->
        <activity
            android:name=".ui.bridge.BridgeSettingsActivity"
            android:label="Computer Bridge"
            android:exported="false"/>
        <activity
            android:name=".ui.bridge.BridgeSetupActivity"
            android:label="Set up Computer Bridge"
            android:exported="false"/>

        <service
            android:name=".services.BridgePollingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"/>

        <receiver
            android:name=".receivers.BridgeBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- ── Share target: appear in Android share sheet ── -->
        <activity
            android:name=".ui.sms.ShareActivity"
            android:label="NexLink"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!-- ── Required: handle sms: URIs (default SMS app) ── -->
        <activity
            android:name=".ui.sms.SendActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO"/>
                <data android:scheme="sms"/>
                <data android:scheme="smsto"/>
                <data android:scheme="mms"/>
                <data android:scheme="mmsto"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- ── Dialer (default phone app) ── -->
        <activity
            android:name=".ui.calls.DialerActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_PRIVILEGED"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- ── Full-screen in-call UI ── -->
        <activity
            android:name=".ui.calls.InCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NexLink"/>

        <!-- ── InCallService — system calls this for call UI ── -->
        <service
            android:name=".services.NexLinkInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_IN_CALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI"      android:value="true"/>
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_RINGING" android:value="true"/>
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
        </service>

        <!-- ── SMS receiver (default SMS app) ── -->
        <receiver android:name=".receivers.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER"/>
            </intent-filter>
        </receiver>

        <!-- ── SMS fallback (not default app) ── -->
        <receiver android:name=".receivers.SmsReceiverFallback" android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- ── MMS WAP push receiver — delegates to android-smsmms PushReceiver (QKSMS pattern) ── -->
        <receiver android:name=".receivers.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER"/>
                <data android:mimeType="application/vnd.wap.mms-message"/>
            </intent-filter>
        </receiver>

        <!-- Diagnostic: also listen on WAP_PUSH_RECEIVED (no default-app requirement) so we
             can confirm the WAP push reaches the app at all, regardless of default SMS status -->
        <receiver android:name=".receivers.WapSniffReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED"/>
                <data android:mimeType="application/vnd.wap.mms-message"/>
            </intent-filter>
        </receiver>

        <!-- Completion handler for SmsManager.downloadMultimediaMessage() -->
        <receiver android:name=".receivers.MmsDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nexlink.app.MMS_DOWNLOADED"/>
            </intent-filter>
        </receiver>

        <!-- ── Quick-reply service (required for default SMS app) ── -->
        <service android:name=".services.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="sms"/>
                <data android:scheme="smsto"/>
                <data android:scheme="mms"/>
                <data android:scheme="mmsto"/>
            </intent-filter>
        </service>

        <!-- ── MMS file provider — exported=false + grantUriPermissions so Android's SmsManager
             grants the telephony service one-shot read access automatically (QKSMS / Fossify approach) ── -->
        <provider
            android:name=".db.MmsFileProvider"
            android:authorities="${applicationId}.MmsFileProvider"
            android:exported="false"
            android:grantUriPermissions="true"/>

        <!-- ── MMS sent-result receiver ── exported=true so Samsung's MMS service can fire the callback -->
        <receiver android:name=".receivers.MmsSentReceiver" android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.MMS_SENT"/>
            </intent-filter>
        </receiver>

        <!-- ── SMS sent callback ── fires when SMS leaves device, clears the clock icon -->
        <receiver android:name=".receivers.SmsSentReceiver" android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.SMS_SENT"/>
            </intent-filter>
        </receiver>

        <!-- ── SMS delivery report receiver ── upgrades to double-tick when carrier confirms delivery -->
        <receiver android:name=".receivers.SmsDeliveredReceiver" android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.SMS_DELIVERED"/>
            </intent-filter>
        </receiver>

        <!-- ── Notification inline reply ── -->
        <receiver android:name=".receivers.NotificationReplyReceiver" android:exported="false"/>

        <!-- ── Notification mark-as-read ── -->
        <receiver android:name=".receivers.NotificationMarkReadReceiver" android:exported="false"/>

        <!-- ── Social notification tap → open social app + mark read ── -->
        <activity
            android:name=".SocialOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ── Outgoing message capture via accessibility ── -->
        <service
            android:name=".services.NexLinkAccessibilityService"
            android:label="NexLink (capture sent messages)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── FileProvider for camera attachments ── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- ── Wearable listener — receives commands from the watch ── -->
        <service
            android:name=".wear.WearMessageDelegate"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/nexlink" />
            </intent-filter>
        </service>

        <!-- ── Social notification listener ── -->
        <service android:name=".services.NexLinkNotificationListener"
            android:exported="true"
            android:label="NexLink Notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

    </application>
</manifest>
