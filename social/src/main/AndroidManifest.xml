<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      docs/social/15-foreground-services.md §15.3.1 — NOTHING is declared here yet.

      Phase 0 ships no foreground services, so it declares no foreground service
      types and no permissions to hold them. §15.3.1: "Declaring a type 'just in
      case' is a review liability — declare only what is used", and §18.9 makes
      the same point about mediaProjection specifically.

      Arriving in later phases:
        phase 3  POST_NOTIFICATIONS, FOREGROUND_SERVICE_DATA_SYNC
        phase 4  FOREGROUND_SERVICE_MICROPHONE / _CAMERA / _MEDIA_PROJECTION,
                 MANAGE_OWN_CALLS (§19.2.2), USE_FULL_SCREEN_INTENT (§19.5.1)

      Each one needs a Play justification (§35.2), so each is added in the phase
      that uses it and not before.
    -->

    <!--
      §16.3.1 — the signature-level permission is DECLARED in :social-contract,
      which both apps depend on. :social holds it so that it can enforce the
      guard on its bridge service in phase 3; NexLink holds it to bind.
    -->
    <!--
      Added in phase 2 (§33.3): the SDK bake-off has to reach the homeserver.
      This is the FIRST permission :social holds, and it is the least
      interesting one Play will ever be asked about.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- §13.4 — message notifications. Runtime-requested on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      §19.2.2 — Social declares this FOR ITSELF, and it is the whole permission
      cost of Telecom integration. Not in a restricted group, and the intended
      permission for an app with its own calls.

      §2.8 #6 and §16.8: nothing here adds a permission to NexLink.
      tools/check-invariants.sh diffs NexLink's manifest on every run.
    -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!--
      §15.6 / §19.5.1 — the incoming-call surface.

      Play scrutinises this one, and the justification is the only one it
      accepts: an incoming call, ringing on a locked or idle screen. It is
      never used for anything else here; the only `setFullScreenIntent` in the
      app is [IncomingCallNotification].
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="${nexlinkBridgePermission}" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:name=".SocialApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexLinkSocial">
        <!--
          allowBackup="false" is deliberate and load-bearing (§12.7.1). The
          crypto store must never reach Google's cloud backup: it holds device
          keys and Megolm sessions, and a backup the operator does not control is
          key material leaving the device (§2.8, invariant 2).
        -->

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ExportActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".DevicesActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".InviteActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- §13.3 — FCM receiver. exported=false; FCM binds it through the
             Play Services permission, not through an exported component. -->
        <service
            android:name=".push.SocialPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          §19.5 — the call surface. Its own task so returning to a call from the
          ongoing notification (§19.5.3) lands here rather than on whatever was
          last open, and excludeFromRecents so an ended call does not leave a
          dead entry someone can resurrect.
        -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:label="@string/app_name" />

        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".VerifyActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".NewChatActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".RecoverySetupActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".CreateAccountActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ConversationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name="com.nexlink.social.ui.onboarding.AcceptanceGateActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- §7.5.2 — restore an archive onto a phone with no session yet. -->
        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- §15.6 — declining a ring takes the notification away, nothing more. -->
        <receiver
            android:name=".call.IncomingCallNotification$DeclineReceiver"
            android:exported="false" />

    </application>
</manifest>
