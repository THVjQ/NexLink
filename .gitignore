.gradle/
app/build/
android-app/build/
shared/build/
wear/build/
# Kept although the social modules moved to THVjQ/NexLink-Social on 2026-09-21.
# Removing these lines while their build output was still on disk made a single
# deletion commit sweep up 8,971 build artefacts — 629,303 insertions and a 2 GB
# push. An ignore rule for a path that no longer exists costs nothing.
social/build/
social-core/build/
social-ui/build/
social-contract/build/
social-rtc/build/
rustls-tls/build/
*.iml
local.properties
keystore.properties
*.jks
*.keystore

# NexLink Social modules

# ── Firebase (§13.3) ────────────────────────────────────────────────────────
# google-services.json ships inside the APK and its API key is restricted by
# package name + signing certificate, so it is not a secret in the strict sense.
# It is ignored anyway because THIS REPOSITORY IS PUBLIC, and publishing a
# project number and app id invites quota abuse for no benefit.
google-services.json

# The service-account key IS a real secret — full admin on the Firebase
# project. It lives on Willard, never here.
*-firebase-adminsdk-*.json
firebase-service-account*.json

# ── LiveKit (§24.1.1) ───────────────────────────────────────────────────────
# API key and secret for the hosted SFU. Config templates live in infra/ with
# placeholders (§24.2.1); the filled-in values do not.
livekit.env
*.livekit-credentials
